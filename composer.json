{
    "name": "dwc/dwcprestamcp",
    "description": "Standalone MCP (Model Context Protocol) server for PrestaShop. Exposes your store to AI agents over its own MCP endpoint, independently of the official ps_mcp_server module.",
    "type": "prestashop-module",
    "license": "MIT",
    "authors": [
        {
            "name": "DWC"
        }
    ],
    "autoload": {
        "psr-4": {
            "DWC\\PrestaMcp\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "mcp/sdk": "^0.8",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "symfony/finder": "^6.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
