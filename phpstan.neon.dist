parameters:
    level: 6
    paths:
        - src
    # src/Tools use a handful of PrestaShop core classes and constants that are
    # only defined at runtime inside a PrestaShop installation. The bootstrap
    # file below provides minimal stubs so static analysis can run standalone
    # (in CI, outside PrestaShop). The MCP SDK classes are resolved from the
    # module's own vendor/ (composer install).
    bootstrapFiles:
        - tests/bootstrap.php
